{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-class-pattern": "^[a-z][a-zA-Z0-9]+$",
    "custom-property-pattern": "^[a-z][a-zA-Z0-9]+$",
    "color-no-hex": null,
    "declaration-property-value-disallowed-list": null
  },
  "overrides": [
    {
      "files": ["frontend/src/**/*.module.css"],
      "rules": {
        "color-no-hex": true
      }
    }
  ]
}
