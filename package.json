{
  "name": "portarr",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted homelab portal (app launcher + operations console) in the spirit of the *arr suite",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc -p agent/tsconfig.json",
    "lint": "eslint frontend tests/e2e agent",
    "lint:fix": "eslint frontend tests/e2e agent --fix",
    "stylelint": "stylelint \"frontend/**/*.css\"",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css}\" \"tests/e2e/**/*.ts\" \"agent/**/*.ts\"",
    "test": "vitest run --config frontend/vite.config.ts",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css}\" \"tests/e2e/**/*.ts\" \"agent/**/*.ts\"",
    "test:agent": "node --test agent/test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "chart.js": "4.6.1",
    "lucide-react": "1.71.0",
    "react": "18.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@semantic-release/exec": "7.1.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "msw": "3.0.4",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "resolutions": {
    "qs": "6.17.1"
  }
}
