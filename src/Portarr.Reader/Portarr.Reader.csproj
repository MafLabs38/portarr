<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>portarr-reader</AssemblyName>
    <RootNamespace>Portarr.Reader</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native AOT (D-102): one binary, no .NET runtime to load or compile at start-up. It also turns on the AOT and trimming
         analyzers, so code that only works with reflection fails the build. Its memory is still too high (ADR 0011): a Rust rewrite follows. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
</Project>
